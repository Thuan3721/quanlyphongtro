@model HeThongQuanLyPhongTro.Models.ToaNha

@{
    ViewData["Title"] = "Thêm tòa nhà";
    Layout = "_Layout";
    var coSoList = ViewBag.CoSoList as List<HeThongQuanLyPhongTro.Models.CoSo>;
}

<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-md overflow-hidden">
    <div class="bg-gradient-to-r from-green-600 to-teal-700 px-6 py-4">
        <h2 class="text-xl font-bold text-white">Thêm tòa nhà mới</h2>
    </div>

    <div class="p-6">
        <form asp-action="Create" method="post">
            <div class="mb-4">
                <label class="block text-gray-700 font-medium mb-2">Tên tòa nhà *</label>
                <input asp-for="TenToaNha" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                <span asp-validation-for="TenToaNha" class="text-red-500 text-sm"></span>
            </div>

            <div class="mb-4">
                <label class="block text-gray-700 font-medium mb-2">Địa chỉ *</label>
                <div class="flex gap-2">
                    <input asp-for="DiaChi" id="txtDiaChi" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required placeholder="VD: Số 1 Đại Cồ Việt" />

                    <button type="button" id="btnLayToaDo" class="bg-indigo-500 hover:bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium transition-all whitespace-nowrap flex items-center">
                        <i class="fas fa-map-marker-alt mr-2"></i> Bắt tọa độ
                    </button>
                </div>
                <span asp-validation-for="DiaChi" class="text-red-500 text-sm block mt-1"></span>

                <input type="hidden" asp-for="ViDo" id="ViDo" />
                <input type="hidden" asp-for="KinhDo" id="KinhDo" />

                <div id="toaDoMsg" class="text-sm font-semibold mt-2"></div>
            </div>

            <div class="mb-4">
                <label class="block text-gray-700 font-medium mb-2">Khu vực *</label>
                <select name="MaCoSo" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                    <option value="">-- Chọn khu vực --</option>
                    @if (coSoList != null)
                    {
                        foreach (var cs in coSoList)
                        {
                            <option value="@cs.MaCoSo">@cs.TenCoSo</option>
                        }
                    }
                </select>
            </div>

            <div class="mb-4">
                <label class="block text-gray-700 font-medium mb-2">Mô tả</label>
                <textarea asp-for="MoTa" rows="3" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                <span asp-validation-for="MoTa" class="text-red-500 text-sm"></span>
            </div>

            <div class="flex gap-3">
                <button type="submit" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg transition-all">
                    <i class="fas fa-save mr-2"></i> Lưu
                </button>
                <a asp-action="Index" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 text-center py-2 rounded-lg transition-all">
                    <i class="fas fa-arrow-left mr-2"></i> Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('btnLayToaDo').addEventListener('click', function() {
            var diaChi = document.getElementById('txtDiaChi').value.trim();
            var msgBox = document.getElementById('toaDoMsg');

            if(!diaChi) {
                msgBox.innerHTML = '<span class="text-red-500"><i class="fas fa-times-circle mr-1"></i> Vui lòng nhập địa chỉ trước!</span>';
                return;
            }

            msgBox.innerHTML = '<span class="text-blue-500"><i class="fas fa-spinner fa-spin mr-1"></i> Đang tìm kiếm tọa độ...</span>';

            // Ghép thêm "Hà Nội, Việt Nam" để tăng độ chính xác tuyệt đối
            var query = encodeURIComponent(diaChi + ", Hà Nội, Việt Nam");
            var url = `https://nominatim.openstreetmap.org/search?format=json&q=${query}&limit=1`;

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if(data && data.length > 0) {
                        var vido = data[0].lat;
                        var kinhdo = data[0].lon;

                        // Đẩy dữ liệu vào 2 input hidden
                        document.getElementById('ViDo').value = vido;
                        document.getElementById('KinhDo').value = kinhdo;

                        msgBox.innerHTML = `<span class="text-green-600"><i class="fas fa-check-circle mr-1"></i> Bắt tọa độ thành công: ${vido}, ${kinhdo}</span>`;
                    } else {
                        msgBox.innerHTML = '<span class="text-red-500"><i class="fas fa-exclamation-triangle mr-1"></i> Không tìm thấy. Hãy thử nhập rõ tên đường và quận nhé.</span>';
                    }
                })
                .catch(error => {
                    msgBox.innerHTML = '<span class="text-red-500"><i class="fas fa-times-circle mr-1"></i> Lỗi kết nối mạng khi tìm tọa độ!</span>';
                });
        });
    </script>
}