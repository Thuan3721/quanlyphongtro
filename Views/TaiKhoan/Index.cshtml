@model IEnumerable<HeThongQuanLyPhongTro.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<body class="bg-gray-100">
    <div class="container mx-auto px-4 py-8">
        <div class="bg-white rounded-xl shadow-md overflow-hidden border border-slate-100">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4 flex justify-between items-center">
                <a asp-action="Create" class="bg-white text-blue-600 px-4 py-2 rounded-lg hover:bg-blue-50 transition-all font-semibold shadow-sm">
                    Thêm tài khoản
                </a>
            </div>

            <div class="p-6">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50 border-b border-gray-100">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Mã</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tên đăng nhập</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Vai trò</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Trạng thái</th>
                                <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var item in Model)
                            {
                                <tr class="hover:bg-gray-50/80 transition-colors font-medium text-slate-700">
                                    <td class="px-4 py-3 font-mono text-slate-400 text-sm">@item.MaTaiKhoan</td>
                                    <td class="px-4 py-3 font-bold text-slate-900">@item.TenDangNhap</td>
                                    <td class="px-4 py-3 text-sm">
                                        @if (item.VaiTro == "Admin")
                                        {
                                            <span class="px-2.5 py-0.5 bg-purple-50 text-purple-700 border border-purple-200 rounded-full text-xs font-bold">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded-full text-xs font-bold">Khách</span>
                                        }
                                    </td>
                                    <td class="px-4 py-3 text-sm">
                                        @if (item.TrangThai == "Hoạt động")
                                        {
                                            <span class="px-2.5 py-0.5 bg-green-50 text-green-700 border border-green-200 rounded-full text-xs font-bold">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-0.5 bg-red-50 text-red-700 border border-red-200 rounded-full text-xs font-bold">
                                                Khóa
                                            </span>
                                        }
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="flex justify-center space-x-3 items-center">
                                            <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan" class="text-yellow-500 hover:text-yellow-700 transition-colors" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button"
                                                    onclick="moPopupXoaTaiKhoan('/TaiKhoan/Delete/@item.MaTaiKhoan', '@item.TenDangNhap', '@item.VaiTro')"
                                                    class="text-red-500 hover:text-red-700 transition-colors focus:outline-none" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>

<div id="deleteTaiKhoanModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-4 overflow-hidden transform scale-95 transition-transform duration-300 border border-gray-100">
        <div class="p-5 bg-slate-50 border-b border-slate-100 flex justify-between items-center">
            <h3 class="font-bold text-slate-800 text-sm md:text-base">
                Xác nhận gỡ bỏ tài khoản người dùng
            </h3>
            <button onclick="dongPopupXoaTaiKhoan()" class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 rounded-lg transition-colors focus:outline-none">
                <i class="fas fa-times text-base"></i>
            </button>
        </div>
        <div class="p-6 space-y-4 text-sm text-slate-600 leading-relaxed">
            <p>Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản đăng nhập này ra khỏi cơ sở dữ liệu không?</p>

            <div class="bg-red-50/40 border border-red-100 rounded-xl p-4 space-y-2 text-slate-700 font-medium">
                <div class="flex items-center gap-1.5">
                    <span class="text-gray-400 font-normal w-32 inline-block">Tên đăng nhập:</span>
                    <span class="text-slate-900 font-bold text-base" id="popupUsername">N/A</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="text-gray-400 font-normal w-32 inline-block">Vai trò hệ thống:</span>
                    <span class="text-blue-600 font-bold" id="popupUserRole">N/A</span>
                </div>
            </div>

            <p class="text-xs text-slate-400 font-normal">Lưu ý: Hành động này sẽ thu hồi toàn bộ quyền truy cập của người dùng này vào hệ thống quản lý tòa nhà và không thể hoàn tác.</p>
        </div>
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-2.5">
            <button onclick="dongPopupXoaTaiKhoan()" type="button" class="px-4 py-2 bg-gray-200 text-gray-700 font-bold text-xs rounded-xl hover:bg-gray-300 transition-colors focus:outline-none">
                Hủy
            </button>
            <a id="btnConfirmDeleteTaiKhoan" href="#" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white font-bold text-xs rounded-xl shadow-md shadow-red-500/10 transition-colors flex items-center justify-center">
                Xác nhận xóa
            </a>
        </div>
    </div>
</div>

<script>
    function moPopupXoaTaiKhoan(deleteUrl, username, role) {
        // Đổ dữ liệu động vào nội dung popup mẫu
        document.getElementById('popupUsername').innerText = username;
        document.getElementById('popupUserRole').innerText = role;

        // Gán link hành động xóa thực tế vào nút đồng ý của popup
        const confirmBtn = document.getElementById('btnConfirmDeleteTaiKhoan');
        confirmBtn.setAttribute('href', deleteUrl);

        // Hiển thị modal đi kèm hiệu ứng chuyển động mượt mà
        const modal = document.getElementById('deleteTaiKhoanModal');
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.querySelector('.transform').classList.remove('scale-95');
        }, 10);

        // Đổi trạng thái hiển thị của nút khi bấm click thực tế để tăng độ chân thật
        confirmBtn.onclick = function() {
            this.style.pointerEvents = 'none';
            this.innerText = 'Đang xóa...';
        };
    }

    function dongPopupXoaTaiKhoan() {
        const modal = document.getElementById('deleteTaiKhoanModal');
        modal.classList.add('opacity-0');
        modal.querySelector('.transform').classList.add('scale-95');
        setTimeout(() => modal.classList.add('hidden'), 300);
    }

    // Nhấn Escape đóng nhanh popup modal ngoài màn hình
    window.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            dongPopupXoaTaiKhoan();
        }
    });
</script>