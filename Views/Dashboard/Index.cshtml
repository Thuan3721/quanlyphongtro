@model HeThongQuanLyPhongTro.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="space-y-6">
     

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100 flex justify-between items-center">
            <div>
                <p class="text-gray-500 text-sm font-medium mb-1">Tổng số phòng</p>
                <h3 class="text-3xl font-bold text-gray-800">@Model.TongSoPhong</h3>
            </div>
            <div class="bg-blue-50 w-12 h-12 flex items-center justify-center rounded-lg text-blue-500 text-xl">
                <i class="fas fa-building"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100 flex justify-between items-center" style="border-left: 4px solid #4ADE80;">
            <div>
                <p class="text-gray-500 text-sm font-medium mb-1">Phòng đã thuê</p>
                <h3 class="text-3xl font-bold text-gray-800">@Model.SoPhongDaThue</h3>
            </div>
            <div class="bg-green-50 w-12 h-12 flex items-center justify-center rounded-lg text-green-500 text-xl">
                <i class="fas fa-door-closed"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100 flex justify-between items-center" style="border-left: 4px solid #FBBF24;">
            <div>
                <p class="text-gray-500 text-sm font-medium mb-1">Phòng trống</p>
                <h3 class="text-3xl font-bold text-gray-800">@Model.SoPhongTrong</h3>
            </div>
            <div class="bg-yellow-50 w-12 h-12 flex items-center justify-center rounded-lg text-yellow-500 text-xl">
                <i class="fas fa-door-open"></i>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100 flex justify-between items-center" style="border-left: 4px solid #C084FC;">
            <div>
                <p class="text-gray-500 text-sm font-medium mb-1">Doanh thu tháng @DateTime.Now.Month</p>
                <h3 class="text-2xl font-bold text-purple-600">@Model.DoanhThuThangNay.ToString("N0") đ</h3>
            </div>
            <div class="bg-purple-50 w-12 h-12 flex items-center justify-center rounded-lg text-purple-500 text-xl">
                <i class="fas fa-chart-line"></i>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100">
        <div class="p-4 bg-orange-50 border-b border-orange-100 flex items-center">
            <i class="fas fa-clock text-orange-500 mr-2"></i>
            <h3 class="font-bold text-orange-800">Hợp đồng sắp hết hạn</h3>
        </div>
        <div class="p-4 overflow-x-auto">
            @if (Model.HopDongSapHetHanList != null && Model.HopDongSapHetHanList.Any())
            {
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="text-gray-500 border-b">
                            <th class="pb-3 font-medium">Phòng</th>
                            <th class="pb-3 font-medium">Khách hàng</th>
                            <th class="pb-3 font-medium text-center">Ngày kết thúc</th>
                            <th class="pb-3 font-medium text-right">Còn lại</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model.HopDongSapHetHanList)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="py-3 text-gray-800">@item.TenPhong</td>
                                <td class="py-3 text-gray-800">@item.TenKhachHang</td>
                                <td class="py-3 text-center text-gray-600">@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                                <td class="py-3 text-right">
                                    <span class="text-red-500 font-medium">@item.SoNgayConLai ngày</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-8">
                    <p class="text-gray-500">Không có hợp đồng nào sắp hết hạn trong 30 ngày tới.</p>
                </div>
            }
        </div>
    </div>
</div>